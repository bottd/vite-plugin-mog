{
  "author": "Drake Bott",
  "license": "MIT",
  "homepage": "https://github.com/bottd/vite-plugin-mog#README",
  "name": "vite-plugin-mog",
  "version": "0.2.1",
  "packageManager": "pnpm@11.13.1",
  "type": "module",
  "description": "A Vite plugin for rendering Mog files",
  "main": "dist/plugin/index.js",
  "types": "dist/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./svelte": {
      "types": "./dist/plugin/types/svelte.d.ts"
    },
    "./react": {
      "types": "./dist/plugin/types/react.d.ts"
    },
    "./vue": {
      "types": "./dist/plugin/types/vue.d.ts"
    },
    "./html": {
      "types": "./dist/plugin/types/html.d.ts"
    },
    "./metadata": {
      "types": "./dist/plugin/types/metadata.d.ts"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "v26.7.0"
  },
  "files": [
    "dist",
    "!dist/napi/*.node"
  ],
  "napi": {
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build": "npm run build:napi && npm run build:js",
    "build:napi": "napi build --release --platform --esm --output-dir dist/napi/",
    "build:js": "rimraf dist/plugin && vite build",
    "clean": "rimraf dist target",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "keywords": [
    "vite",
    "plugin",
    "mog",
    "markup",
    "napi",
    "rust",
    "svelte",
    "react",
    "vue"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "svelte": "^5.0.0",
    "vite": "^8.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@napi-rs/cli": "3.8.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/npm": "13.1.5",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.8.0",
    "jiti": "2.7.0",
    "playwright": "1.61.1",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "rimraf": "6.1.3",
    "semantic-release": "25.0.8",
    "svelte": "5.56.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10",
    "vue": "3.5.40"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bottd/vite-plugin-mog.git"
  },
  "optionalDependencies": {
    "vite-plugin-mog-darwin-x64": "0.2.1",
    "vite-plugin-mog-darwin-arm64": "0.2.1",
    "vite-plugin-mog-linux-x64-gnu": "0.2.1",
    "vite-plugin-mog-linux-arm64-gnu": "0.2.1",
    "vite-plugin-mog-linux-x64-musl": "0.2.1",
    "vite-plugin-mog-linux-arm64-musl": "0.2.1"
  }
}